{
  "name": "@n24q02m/workspace",
  "mcpName": "io.github.n24q02m/better-workspace-mcp",
  "version": "0.6.0-beta.1",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -build && node scripts/build-cli.js",
    "dev": "tsx watch scripts/start-server.ts",
    "test": "vitest --passWithNoTests",
    "test:coverage": "vitest --coverage",
    "lint": "biome lint src",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "check": "biome check . && bun run type-check",
    "check:fix": "biome check --write . && bun run type-check",
    "prepublishOnly": "bun run build"
  },
  "bin": {
    "workspace": "bin/cli.mjs",
    "better-workspace-mcp": "bin/cli.mjs"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "files": [
    "build/",
    "bin/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@n24q02m/hull": "^0.4.0",
    "googleapis": "^180.0.0",
    "google-auth-library": "^11.0.0",
    "zod": "^4.4.3"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "google-auth-library": "^11.0.0",
    "gaxios": "^8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "main": "build/src/init-server.js",
  "description": "Google Workspace MCP — Docs, Drive, Calendar, Gmail, Sheets, Slides, Tasks, Chat, People, Forms",
  "repository": {
    "type": "git",
    "url": "https://github.com/n24q02m/workspace.git"
  },
  "bugs": {
    "url": "https://github.com/n24q02m/workspace/issues"
  },
  "homepage": "https://github.com/n24q02m/workspace#readme",
  "author": "n24q02m"
}
